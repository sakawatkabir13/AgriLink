# Supabase — public, safe in the browser
VITE_SUPABASE_URL=https://<your-project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<your-anon-key>

# The variables below are server-side only (Supabase Edge Functions / Stripe).
# Do NOT prefix them with VITE_ and do NOT commit real values.

# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# LLM provider used by the `ai-chat` Edge Function
# OPENAI_API_KEY=sk-...
